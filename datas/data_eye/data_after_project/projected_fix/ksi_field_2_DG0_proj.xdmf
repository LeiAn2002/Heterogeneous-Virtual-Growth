<?xml version="1.0"?>
<!DOCTYPE Xdmf SYSTEM "Xdmf.dtd" []>
<Xdmf Version="3.0" xmlns:xi="https://www.w3.org/2001/XInclude">
  <Domain>
    <Grid Name="mesh" GridType="Uniform">
      <Topology TopologyType="Quadrilateral" NumberOfElements="10000" NodesPerElement="4">
        <DataItem Dimensions="10000 4" NumberType="Int" Format="HDF">ksi_field_2_DG0_proj.h5:/Mesh/mesh/topology</DataItem>
      </Topology>
      <Geometry GeometryType="XY">
        <DataItem Dimensions="10201 2" Format="HDF">ksi_field_2_DG0_proj.h5:/Mesh/mesh/geometry</DataItem>
      </Geometry>
    </Grid>
    <Grid Name="ksi_field_2_DG0_proj" GridType="Collection" CollectionType="Temporal">
      <Grid Name="ksi_field_2_DG0_proj" GridType="Uniform">
        <xi:include xpointer="xpointer(/Xdmf/Domain/Grid[@GridType='Uniform'][1]/*[self::Topology or self::Geometry])" />
        <Time Value="0" />
        <Attribute Name="ksi_field_2_DG0_proj" AttributeType="Scalar" Center="Cell">
          <DataItem Dimensions="10000 1" Format="HDF">ksi_field_2_DG0_proj.h5:/Function/ksi_field_2_DG0_proj/0</DataItem>
        </Attribute>
      </Grid>
    </Grid>
  </Domain>
</Xdmf>
